---
import Shell from "../layouts/Shell.astro";
---
<Shell title="Not found — Course navigator">
  <h1>That page is not here</h1>
  <p class="lede">
    Either the address is wrong, or the resource is not published to students.
  </p>
  <p class="empty">
    Everything this demonstration student can open is listed, in order, on each
    course's contents page in the navigation. If it is not there, it is not
    available — there is no second place to look.
  </p>
  <p><a class="btn" href="/">Back to Overview</a> <a class="btn" href="/search/">Search</a></p>
</Shell>
