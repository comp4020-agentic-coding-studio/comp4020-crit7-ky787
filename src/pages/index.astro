---
import Shell from "../layouts/Shell.astro";
import Flash from "../components/Flash.astro";
import {
  getVisibleItemsById,
  listSaves,
  recentVisits,
  recentlyReleased,
  upcomingAssessments,
} from "../lib/queries";
import { feedbackPath, itemPath } from "../lib/paths";
import { formatDateTime, relativeDays } from "../lib/term";

/**
 * Overview answers "what needs my attention?".
 *
 * It deliberately does not repeat the navigation. There is no wall of course
 * cards here, because the courses are in the column on the left and always
 * were; what Canvas puts behind a To Do flyout and a separate grades tab is
 * what this page is for.
 */
const now = new Date();
const visitorId = Astro.locals.visitorId;

const due = upcomingAssessments(now, 5);
const briefs = getVisibleItemsById(due.map((row) => row.assessment.itemId));
const released = recentlyReleased(4);
const releasedBriefs = getVisibleItemsById(released.map((row) => row.assessment.itemId));

const visited = recentVisits(visitorId, 4);
const saved = listSaves(visitorId).slice(0, 4);
const percent = (score: number, max: number) => Math.round((score / max) * 100);
/** The first real paragraph of the feedback, unwrapped, as the preview. */
const preview = (feedback: string) => {
  const paragraph = feedback
    .split(/\n\s*\n/)
    .map((block) => block.replace(/\s+/g, " ").trim())
    .find((block) => block !== "" && !block.startsWith("#") && !block.startsWith("**"));
  if (!paragraph) return "";
  return paragraph.length > 200 ? `${paragraph.slice(0, 200).replace(/\s+\S*$/, "")}…` : paragraph;
};
---

<Shell title="Overview — Course navigator" description="Upcoming demonstration assessment, recent marks and feedback, and where you left off.">
  <h1>Overview</h1>
  <p class="lede">
    What needs attention, in one place. Your courses and their full contents are
    in the navigation, not repeated here.
  </p>

  <Flash />

  <div class="panel-pair">
  <section class="panel" aria-labelledby="due-next">
    <h2 id="due-next">Due next</h2>
    {
      due.length === 0 ? (
        <p class="empty">
          Nothing due in the demonstration data. Every assessment in this
          prototype has a fixed fictional date, so this list empties rather than
          quietly moving deadlines forward.
        </p>
      ) : (
        <ul class="stack">
          {due.map(({ assessment, course }) => {
            const brief = briefs.get(assessment.itemId);
            return (
              <li class="card">
                <p class="title">
                  {brief ? (
                    <a href={itemPath(course, brief)}>
                      {assessment.label} — {assessment.title}
                    </a>
                  ) : (
                    `${assessment.label} — ${assessment.title}`
                  )}
                </p>
                <p class="meta">
                  <span>{course.title}</span>
                  <span>{assessment.weight}% of the course</span>
                  <span>Due {formatDateTime(assessment.dueAt)}</span>
                  <span class="due-soon">{relativeDays(assessment.dueAt, now)}</span>
                </p>
              </li>
            );
          })}
        </ul>
      )
    }
    <p class="hint">Times shown in Australia/Sydney. Demonstration dates.</p>
  </section>

  <section class="panel" aria-labelledby="recent-marks">
    <h2 id="recent-marks">Recent marks and feedback</h2>
    {
      released.length === 0 ? (
        <p class="empty">No released marks in the demonstration data yet.</p>
      ) : (
        <ul class="stack">
          {released.map(({ assessment, result, course }) => {
            const brief = releasedBriefs.get(assessment.itemId);
            return (
              <li class="card">
                <p class="title">
                  <a href={feedbackPath(course, assessment.id)}>
                    {assessment.label} — {assessment.title}
                  </a>
                  <span class="score"> · {result.score} / {assessment.maxScore} ({percent(result.score, assessment.maxScore)}%)</span>
                </p>
                <p class="meta">
                  <span>{course.title}</span>
                  <span>Released {result.releasedAt ? formatDateTime(result.releasedAt) : "—"}</span>
                  {brief && (
                    <>
                      <a href={itemPath(course, brief)}>the brief</a>
                    </>
                  )}
                </p>
                <p>{preview(result.feedback)}</p>
                <p class="meta">
                  <a href={feedbackPath(course, assessment.id)}>Read the full feedback</a>
                </p>
              </li>
            );
          })}
        </ul>
      )
    }
    <p class="hint">
      Fictional marks on fictional work. Unreleased marks are not listed here and
      have no page.
    </p>
  </section>

  </div>

  <section class="panel" aria-labelledby="continue">
    <h2 id="continue">Continue studying</h2>
    {
      visited.length === 0 && saved.length === 0 ? (
        <p class="empty">
          Nothing opened yet in this browser session. Open a course from the
          navigation and anything you read will appear here.
        </p>
      ) : (
        <>
          {visited.length > 0 && (
            <>
              <h3>Recently opened</h3>
              <ul class="stack">
                {visited.map(({ item, course }) => (
                  <li class="card">
                    <p class="title"><a href={itemPath(course, item)}>{item.title}</a></p>
                    <p class="meta"><span>{course.title}</span></p>
                  </li>
                ))}
              </ul>
            </>
          )}
          {saved.length > 0 && (
            <>
              <h3>Saved for revision</h3>
              <ul class="stack">
                {saved.map(({ item, course, note }) => (
                  <li class="card">
                    <p class="title"><a href={itemPath(course, item)}>{item.title}</a></p>
                    <p class="meta"><span>{course.title}</span></p>
                    {note && <p class="note-display">{note}</p>}
                  </li>
                ))}
              </ul>
              <p class="meta"><a href="/saved/">All saved resources and notes</a></p>
            </>
          )}
        </>
      )
    }
  </section>
</Shell>
